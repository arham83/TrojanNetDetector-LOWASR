    "def add_pattern_trigger(images):\n",
    "    \"\"\"Exact five-pixel X from dataset_input.poison('pattern'); accepts CHW or NCHW.\"\"\"\n",
    "    if images.ndim not in (3, 4):\n",
    "        raise ValueError(f\"Expected CHW or NCHW input, got {tuple(images.shape)}\")\n",
    "    out = images.clone()\n",
    "    row, col = trigger_position\n",
    "    locations = ((row, col), (row+1, col+1), (row-1, col+1),\n",
    "                 (row+1, col-1), (row-1, col-1))\n",
    "    height, width = out.shape[-2:]\n",
    "    if any(not (0 <= r < height and 0 <= c < width) for r, c in locations):\n",
    "        raise ValueError(\"Configured trigger extends outside the image\")\n",
    "    color = torch.tensor(trigger_color, dtype=out.dtype, device=out.device).div(255.0)\n",
    "    for r, c in locations:\n",
    "        if out.ndim == 3: out[:, r, c] = color\n",
    "        else: out[:, :, r, c] = color.view(1, 3)\n",
    "    return out\n",
    "\n",
    "class ReverseTrainingDataset(Dataset):\n",
